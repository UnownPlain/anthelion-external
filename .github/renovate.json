{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
	"minimumReleaseAge": "7 days",
	"packageRules": [
		{
			"matchUpdateTypes": ["minor", "patch", "digest"],
			"automerge": true
		}
	],
	"npm": {
		"enabled": false
	}
}
